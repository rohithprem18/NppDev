{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NppDev",
  "version": "2.0.0",
  "identifier": "dev.rohithprem.nppdev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NppDev",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "backgroundColor": "#0a0a0a",
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "publisher": "Rohith Prem",
    "copyright": "Copyright (C) Rohith Prem. GPL-3.0.",
    "category": "DeveloperTool",
    "shortDescription": "A fast, lightweight code editor for practice",
    "longDescription": "NppDev: write, run and judge C, C++, Java, Python, JavaScript, Go, Rust, Kotlin and C# with one key, with IntelliSense and input / expected output checking.",
    "homepage": "https://github.com/rohithprem18/NppDev",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "section": "devel"
      }
    }
  }
}
