{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": false,
    "types": ["vite/client"],
    "paths": { "@monaco/*": ["./node_modules/monaco-editor/esm/vs/*"], "@monaco-lsp": ["./node_modules/monaco-editor/esm/external/monaco-lsp-client/out/index.d.ts"] }
  },
  "include": ["src"]
}
