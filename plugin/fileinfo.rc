/* Version information (Properties > Details) for the Dev Tools plugin and pyrun.exe.
   build.ps1 compiles it twice: -DFILE_DESC="..." -DFILE_NAME="..." -DFILE_TYPE=VFT_DLL or VFT_APP. */
#include <winver.h>
#include "version.h"            /* written by build.ps1 from the VERSION file */

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_MAJOR, VER_MINOR, 0, 0
PRODUCTVERSION VER_MAJOR, VER_MINOR, 0, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE FILE_TYPE
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Rohith Prem"
      VALUE "FileDescription", FILE_DESC
      VALUE "FileVersion", VER_TEXT
      VALUE "InternalName", FILE_NAME
      VALUE "OriginalFilename", FILE_NAME
      VALUE "ProductName", "NppDev - Notepad++ Dev Edition"
      VALUE "ProductVersion", VER_TEXT
      VALUE "LegalCopyright", "Copyright (C) Rohith Prem. GPL-3.0."
      VALUE "Comments", "https://github.com/rohithprem18/NppDev"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
